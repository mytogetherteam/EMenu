# Copy to .env and adjust per environment:  cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here — everything in this file ships to the client.

# MyShop API base (includes /api prefix path segments after this host).
# Example shop: GET {VITE_API_BASE_URL}/user/shop-profile/slug/wai-yan
VITE_API_BASE_URL=http://localhost:3000/api
