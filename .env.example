# Copy to .env and adjust per environment:  cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here — everything in this file ships to the client.

# Base URL every request in src/helpers/apiClient.ts is prefixed with.
# Demo value points at JSONPlaceholder; use /api (same-origin) or your real API host.
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com
